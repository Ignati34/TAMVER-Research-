---
import DecisionCrystal from './DecisionCrystal';
import type { Lang } from '../i18n/config';
const {
  eyebrow='TAMVER RESEARCH / KNOWLEDGE',
  title='Knowledge\\Library',
  text='Methodologies, evidence, claims and research domains connected through the TAMVER Decision Security provenance graph.',
  lang='en'
} = Astro.props as {eyebrow?:string;title?:string;text?:string;lang?:Lang};
---
<section class="knowledge-hero tv-shell">
  <div class="hero-copy">
    <div class="tv-eyebrow hero-eyebrow">{eyebrow}</div>
    <h1 class="liquid-metal-title">{title}</h1>
    <p class="tv-lead hero-lead">{text}</p>
  </div>
  <div class="visual"><DecisionCrystal client:load lang={lang} /></div>
  <div class="meta"><span>01 / SYSTEM</span><span>MOTION CRYSTAL · DECISION EVIDENCE + RESEARCH</span></div>
</section>
<style>
.knowledge-hero{
  min-height:calc(115vh - 98px);
  display:grid;
  grid-template-columns:minmax(310px,.68fr) minmax(640px,1.32fr);
  grid-template-rows:1fr auto;
  align-items:center;
  padding:34px 0 24px;
  position:relative;
}
.hero-copy{z-index:2;align-self:center;padding-left:4px;transform:translate(calc(var(--tamver-gutter) * -.5),-4px)}
.hero-eyebrow{margin-bottom:22px}.hero-lead{max-width:590px}
.visual{
  width:108%;
  margin-left:-4%;
  height:min(800px,72vh);
  min-height:620px;
  position:relative;
  transform:translateY(-18px);
  z-index:1;
}
.meta{grid-column:1/-1;width:100%;padding-top:18px;border-top:1px solid var(--tamver-line-soft);display:flex;justify-content:space-between;font-size:9px;letter-spacing:.18em;color:rgba(244,241,234,.38);text-transform:uppercase;position:relative;z-index:3}

:global(.crystal-wrap){position:relative;width:100%;height:100%;isolation:isolate;overflow:visible}
:global(.crystal-canvas){position:absolute;inset:-8% -7% -4%;filter:drop-shadow(0 0 42px rgba(245,198,139,.15));pointer-events:none}
:global(.core-label){position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;text-shadow:0 0 24px #050704}
:global(.core-label span){display:block;font-size:8px;letter-spacing:.38em;color:rgba(244,241,234,.55)}
:global(.core-label strong){display:block;margin-top:7px;font-size:18px;letter-spacing:.065em;line-height:1.02;font-weight:300}
:global(.core-label small){display:block;margin-top:9px;font-size:8px;letter-spacing:.18em;text-transform:uppercase;color:rgba(244,241,234,.48)}

:global(.network-lines){position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}
:global(.network-lines line){stroke:rgba(245,198,139,.20);stroke-width:.11;stroke-dasharray:.7 1.3;vector-effect:non-scaling-stroke;transition:stroke .3s,opacity .3s}
:global(.network-lines line.foundation-line){stroke:rgba(245,198,139,.14);stroke-dasharray:1.4 2.5}
:global(.network-lines line.signal){stroke:var(--tamver-alert-hot);stroke-width:.24;stroke-dasharray:1.5 2.7;animation:signalRun .55s linear infinite;filter:drop-shadow(0 0 4px rgba(255,72,64,.85))}

:global(.graph-node){
  position:absolute;transform:translate(-50%,-50%);display:grid;grid-template-columns:16px minmax(0,auto);grid-template-rows:auto auto;
  column-gap:9px;min-width:150px;max-width:190px;padding:7px 8px;text-align:left;color:rgba(244,241,234,.62);
  transition:transform .25s var(--tamver-ease),filter .25s var(--tamver-ease);z-index:6;border-radius:2px;
}
:global(a.graph-node){cursor:pointer}
:global(.graph-node i){grid-row:1/3;width:9px;height:9px;border:1px solid var(--tamver-amber-hot);border-radius:50%;margin-top:5px;box-shadow:0 0 0 5px rgba(245,198,139,.035),0 0 20px rgba(245,198,139,.14)}
:global(.graph-node b){font-size:10px;letter-spacing:.2em;color:var(--tamver-white);font-weight:400;white-space:nowrap}
:global(.graph-node span){font-size:9px;color:rgba(244,241,234,.42);margin-top:3px;white-space:normal;line-height:1.25;max-width:150px}
:global(a.graph-node:hover),:global(a.graph-node:focus-visible){transform:translate(-50%,-50%) scale(1.055);filter:drop-shadow(0 0 14px rgba(245,198,139,.16));outline:1px solid rgba(245,198,139,.12);outline-offset:3px}
:global(.graph-node.flash i){background:var(--tamver-alert-hot);border-color:#ff746c;box-shadow:0 0 0 9px rgba(223,48,43,.11),0 0 28px rgba(255,70,61,.95),0 0 72px rgba(223,48,43,.60);animation:nodeFlash 1.7s var(--tamver-ease) both}
:global(.graph-node.flash b){color:#ff625a;text-shadow:0 0 15px rgba(255,75,65,.7)}

:global(.graph-node-core){
  min-width:168px;max-width:190px;pointer-events:auto;text-align:center;grid-template-columns:14px auto;opacity:.82;cursor:pointer;
  transform:translate(-50%,-50%)!important;filter:none!important;
}
:global(.graph-node-core i){border-color:rgba(245,198,139,.62);background:rgba(245,198,139,.08);box-shadow:0 0 18px rgba(245,198,139,.16)}
:global(.graph-node-core b){color:rgba(244,241,234,.82)}
:global(.graph-node-core span){color:rgba(244,241,234,.35)}

@keyframes signalRun{to{stroke-dashoffset:-4.2}}
@keyframes nodeFlash{0%{filter:brightness(2);transform:scale(.7)}18%{filter:brightness(4);transform:scale(1.55)}55%{filter:brightness(2.1);transform:scale(1.05)}100%{filter:brightness(1);transform:scale(1)}}

@media(max-width:1180px){
  .knowledge-hero{grid-template-columns:minmax(280px,.72fr) minmax(520px,1.28fr)}
  .visual{width:105%;height:min(790px,76vh);min-height:620px;transform:translateY(-26px)}
  :global(.graph-node){min-width:132px;max-width:160px}
}
@media(max-width:1000px){
  .knowledge-hero{grid-template-columns:1fr;padding-top:54px}
  .hero-copy{text-align:center;transform:none}.hero-eyebrow{margin-inline:auto}.hero-lead{margin-inline:auto}
  .visual{width:100%;margin-left:0;height:700px;min-height:650px;transform:translateY(-16px)}
  .meta{display:none}
  :global(.graph-node span){display:none}
  :global(.graph-node){min-width:78px;max-width:110px;padding:6px}
  :global(.graph-node-core){min-width:116px;display:grid}
  :global(.graph-node-core span){display:block}
}
@media(prefers-reduced-motion:reduce){
  :global(.network-lines line.signal){animation:none}
  :global(.graph-node.flash i){animation:none}
}
</style>
