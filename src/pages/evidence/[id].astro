---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { evidence, getSource, claims } from '../../lib/ledger/mock';
export function getStaticPaths(){return evidence.filter(e=>['approved','public'].includes(e.status)).map(e=>({params:{id:e.id},props:{item:e}}));}
const { item }=Astro.props; const sources=item.sourceIds.map(getSource).filter(Boolean); const supporting=claims.filter(c=>c.evidenceIds.includes(item.id)&&['approved','public'].includes(c.status));
---
<BaseLayout title={item.title} description={item.summary}><article class="tv-section tv-shell evidence-item"><div class="tv-eyebrow">EVIDENCE / {item.id}</div><h1 class="tv-h1">{item.title}</h1><p class="tv-lead">{item.summary}</p><div class="facts"><span>STATUS <b>{item.status}</b></span><span>CONFIDENCE <b>{item.confidence}</b></span><span>REVIEWED <b>{item.reviewedAt||'—'}</b></span></div><section><div class="tv-eyebrow">SOURCE LINEAGE</div>{sources.map((s:any)=><div class="row"><span>{s.id}</span><strong>{s.title}</strong><em>{s.sourceClass}</em></div>)}</section><section><div class="tv-eyebrow">SUPPORTED PUBLIC CLAIMS</div>{supporting.map((c:any)=><a class="row" href={`/claims/${c.id}/`}><span>{c.id}</span><strong>{c.title}</strong><em>{c.status}</em></a>)}</section></article></BaseLayout>
<style>.evidence-item{max-width:1050px}.facts{display:flex;gap:36px;padding:22px 0;margin:42px 0 70px;border-top:1px solid var(--tv-line);border-bottom:1px solid var(--tv-line);font-size:9px;letter-spacing:.15em;color:#6d7c84}.facts b{color:#d7e1e6}section{margin:60px 0}.row{display:grid;grid-template-columns:140px 1fr auto;gap:18px;padding:19px 0;border-top:1px solid var(--tv-line)}.row span,.row em{font-size:9px;letter-spacing:.12em;color:#6d7c84;font-style:normal;text-transform:uppercase}.row strong{font-size:14px;font-weight:520}@media(max-width:750px){.facts{flex-direction:column;gap:10px}.row{grid-template-columns:110px 1fr}.row em{display:none}}</style>
