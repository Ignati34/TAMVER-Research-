---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EvidenceAnalyticsWorkbench from '../../../components/EvidenceAnalyticsWorkbench';
import { localizedLangs,isLang,type Lang } from '../../../i18n/config';
import { t } from '../../../i18n/messages';

export function getStaticPaths(){return localizedLangs.map(lang=>({params:{lang}}));}
const lang=(isLang(Astro.params.lang)?Astro.params.lang:'en') as Lang;
const m=t(lang);
---
<BaseLayout title={m.ledger.title} lang={lang}>
  <section class="wrap ledger-intro">
    <div class="eyebrow">{m.ledger.eyebrow}</div>
    <h2>{m.ledger.title}</h2>
    <p>{m.ledger.lead}</p>
  </section>
  <section class="ledger-workbench">
    <EvidenceAnalyticsWorkbench client:load lang={lang} />
  </section>
</BaseLayout>
<style>
.ledger-intro{padding:110px 0 46px;text-align:center}.ledger-intro h2{max-width:1050px;margin:22px auto}.ledger-intro p{max-width:850px;margin:0 auto 20px}.ledger-workbench{padding:0 0 120px}
</style>
