---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrystalHero from '../../../components/CrystalHero.astro';
import { getCollection } from 'astro:content';
import { localizedLangs,isLang,type Lang } from '../../../i18n/config';
import { t } from '../../../i18n/messages';
import { localizeKnowledge, localizeKnowledgeType, localizeKnowledgeTag } from '../../../i18n/knowledge';

export function getStaticPaths(){return localizedLangs.map(lang=>({params:{lang}}));}
const lang=(isLang(Astro.params.lang)?Astro.params.lang:'en') as Lang;
const m=t(lang);
const items=await getCollection('knowledge');
---
<BaseLayout title={m.knowledge.title} lang={lang}>
  <CrystalHero lang={lang} eyebrow={m.knowledge.eyebrow} title={m.home.title} text={m.knowledge.lead}/>
  <div class="tv-rule"></div>
  <section class="tv-section tv-shell">
    <div class="tv-eyebrow">{m.knowledge.index}</div>
    <div class="tv-grid">
      {items.map((item,i)=>{
        const id=item.id.replace(/\.(md|mdx)$/,'');
        const c=localizeKnowledge(id,lang,item.data.title,item.data.description);
        return <a class="tv-panel item" href={`/${lang}/knowledge/${id}/`}>
          <span class="tv-index">{String(i+1).padStart(2,'0')}</span>
          <div class="tv-eyebrow">{localizeKnowledgeType(item.data.type,lang)}</div>
          <h3>{c.title}</h3>
          <p>{c.description}</p>
          {item.data.tags.slice(0,2).map(tag=><span class="tv-chip">{localizeKnowledgeTag(tag,lang)}</span>)}
        </a>
      })}
    </div>
  </section>
</BaseLayout>
<style>.item{grid-column:span 4}@media(max-width:900px){.item{grid-column:1/-1}}</style>
