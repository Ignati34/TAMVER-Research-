---
import BaseLayout from '../../../layouts/BaseLayout.astro';import EvidenceImpactCrystal from '../../../components/EvidenceImpactCrystal';import { localizedLangs,isLang,type Lang } from '../../../i18n/config';import { t } from '../../../i18n/messages';export function getStaticPaths(){return localizedLangs.map(lang=>({params:{lang}}));}const lang=(isLang(Astro.params.lang)?Astro.params.lang:'en') as Lang,m=t(lang);
---
<BaseLayout title={m.impact.title.replace('\\n',' ')} lang={lang}><section class="tv-shell tv-section impact-hero-copy"><div class="tv-eyebrow">{m.impact.eyebrow}</div><h1 class="impact-title">{m.impact.title.split('\\n').map((x,i)=><>{i>0&&<br/>}{x}</>)}</h1><p class="tv-lead">{m.impact.lead}</p><div class="tv-translation-note">{m.knowledge.fallback}</div></section><section class="tv-section"><EvidenceImpactCrystal client:load evidenceId="ev-supplier-single-point" /></section><section class="tv-shell tv-section impact-explain"><div class="tv-eyebrow">{m.impact.exact}</div><div class="tv-grid"><div class="tv-panel" style="grid-column:span 6"><span class="tv-index">01 / V12 FACT</span><h3>{m.impact.factTitle}</h3><p>{m.impact.factText}</p></div><div class="tv-panel" style="grid-column:span 6"><span class="tv-index">02 / V0.5 PROJECTION</span><h3>{m.impact.projectionTitle}</h3><p>{m.impact.projectionText}</p></div></div></section></BaseLayout>
