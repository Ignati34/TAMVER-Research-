---
import BaseLayout from '../../../layouts/BaseLayout.astro';import AndorraScenarioLab from '../../../components/AndorraScenarioLab';import { localizedLangs,isLang,type Lang } from '../../../i18n/config';import { t } from '../../../i18n/messages';export function getStaticPaths(){return localizedLangs.map(lang=>({params:{lang}}));}const lang=(isLang(Astro.params.lang)?Astro.params.lang:'en') as Lang,m=t(lang);
---
<BaseLayout title={m.andorra.title.replace('\\n',' ')} lang={lang}><section class="tv-section tv-shell case-head"><div class="tv-eyebrow">{m.andorra.eyebrow}</div><h1 class="tv-h1">{m.andorra.title.split('\\n').map((x,i)=><>{i>0&&<br/>}{x}</>)}</h1><p class="tv-lead">{m.andorra.lead}</p><div class="warning">{m.andorra.warning}</div></section><section class="tv-shell"><AndorraScenarioLab client:load lang={lang}/></section><section class="tv-section tv-shell source-note"><div class="tv-eyebrow">{m.andorra.boundary}</div><p>{m.andorra.boundaryText}</p></section></BaseLayout><style>.case-head{padding-bottom:46px}.warning{margin-top:38px;padding:15px 18px;border-left:1px solid rgba(245,198,139,.55);background:rgba(245,198,139,.035);font-size:10px;letter-spacing:.15em;color:rgba(244,241,234,.6)}.source-note{padding-top:54px}.source-note p{max-width:900px;color:rgba(244,241,234,.52);line-height:1.65;font-size:13px}</style>
