---
import BaseLayout from '../../layouts/BaseLayout.astro';import CrystalHero from '../../components/CrystalHero.astro';import { getCollection } from 'astro:content';
const items=await getCollection('knowledge');
---
<BaseLayout title="Knowledge Library"><CrystalHero eyebrow="TAMVER RESEARCH / KNOWLEDGE" title="Knowledge\nLibrary" text="Methodologies, analytical products, evidence structures and research domains connected through the TAMVER Decision Security graph."/><div class="tv-rule"></div><section class="tv-section tv-shell"><div class="tv-eyebrow">03 / ENTITY INDEX</div><div class="tv-grid">{items.map((item,i)=><a class="tv-panel item" href={`/knowledge/${item.id.replace(/\.(md|mdx)$/,'')}/`}><span class="tv-index">{String(i+1).padStart(2,'0')}</span><div class="tv-eyebrow">{item.data.type}</div><h3>{item.data.title}</h3><p>{item.data.description}</p>{item.data.tags.slice(0,2).map(t=><span class="tv-chip">{t}</span>)}</a>)}</div></section></BaseLayout>
<style>.item{grid-column:span 4}@media(max-width:900px){.item{grid-column:1/-1}}</style>
