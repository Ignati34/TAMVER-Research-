---
import BaseLayout from '../../layouts/BaseLayout.astro';import { getCollection,render } from 'astro:content';
export async function getStaticPaths(){const entries=await getCollection('knowledge');return entries.map(entry=>({params:{slug:entry.id.replace(/\.(md|mdx)$/,'')},props:{entry}}))}
const {entry}=Astro.props;const {Content}=await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description}><article class="entity tv-shell"><div class="side"><div class="tv-eyebrow">{entry.data.type} / {entry.data.status}</div><div class="number">TMR-{entry.id.slice(0,3).toUpperCase()}</div><div class="mini"><span>Updated</span><b>{entry.data.updated.toISOString().slice(0,10)}</b><span>Pillar</span><b>{entry.data.pillar||'—'}</b><span>Evidence</span><b>{entry.data.evidence.length}</b></div></div><div class="main"><h1 class="tv-h1">{entry.data.title}</h1><p class="tv-lead">{entry.data.description}</p><div class="tv-rule gap"></div><div class="prose"><Content/></div>{entry.data.related.length>0&&<aside><div class="tv-eyebrow">Connected nodes</div>{entry.data.related.map(x=><a class="tv-chip" href={`/knowledge/${x}/`}>{x}</a>)}</aside>}</div></article></BaseLayout>
<style>.entity{display:grid;grid-template-columns:240px minmax(0,820px);gap:90px;padding:100px 0 140px}.side{position:sticky;top:120px;align-self:start}.number{font-size:11px;letter-spacing:.2em;color:#56666e;margin:22px 0 42px}.mini{display:grid;gap:6px}.mini span{font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#53636b;margin-top:12px}.mini b{font-size:12px;color:#a4b3bb;font-weight:500}.gap{margin:46px 0}.prose :global(h2){font-size:32px;letter-spacing:-.035em;margin:54px 0 18px}.prose :global(h3){font-size:21px;margin:38px 0 14px}.prose :global(p),.prose :global(li){color:#8c9ba3;line-height:1.75}.prose :global(ul){padding-left:20px}aside{margin-top:64px;padding-top:24px;border-top:1px solid var(--tv-line)}@media(max-width:850px){.entity{grid-template-columns:1fr;gap:20px}.side{position:static}.mini{grid-template-columns:repeat(3,1fr)}}</style>
